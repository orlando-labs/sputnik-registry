#!/usr/bin/env python3
"""Snapshot current non-ignored sources from registry and its sibling SDKs."""
import hashlib
import io
import json
from pathlib import Path
import subprocess
import tarfile
import time

root = Path(__file__).resolve().parents[1]
output = root / '.build' / 'container-context.tar.gz'
output.parent.mkdir(parents=True, exist_ok=True)
manifest = {'schema': 'sputnik.registry.container-sources.v1', 'files': {}}
with tarfile.open(output, 'w:gz') as archive:
    for name in ('sputnik-lang', 'orbit', 'sqlite3', 'sputnik-registry'):
        repository = root.parent / name
        paths = subprocess.check_output(
            ['git', 'ls-files', '-z', '--cached', '--others', '--exclude-standard'], cwd=repository)
        for relative in sorted(set(paths.decode().split('\0')) - {''}):
            path = repository / relative
            if not path.is_file():
                continue
            if path.is_symlink():
                raise RuntimeError('Source symlink requires explicit handling: ' + str(path))
            data = path.read_bytes()
            target = name + '/' + relative
            manifest['files'][target] = hashlib.sha256(data).hexdigest()
            info = tarfile.TarInfo(target)
            info.size = len(data)
            info.mode = 0o755 if path.stat().st_mode & 0o111 else 0o644
            info.mtime = path.stat().st_mtime
            archive.addfile(info, io.BytesIO(data))
    data = (json.dumps(manifest, sort_keys=True, indent=2) + '\n').encode()
    info = tarfile.TarInfo('SOURCE-MANIFEST.json')
    info.size = len(data)
    info.mode = 0o644
    info.mtime = time.time()
    archive.addfile(info, io.BytesIO(data))
print(output)
print('sha256:' + hashlib.sha256(output.read_bytes()).hexdigest())
